# === База данных (раздел 20) ===
# Для локальной разработки — docker-compose (postgres:16). Для Supabase — подставьте
# сюда connection string из Project Settings -> Database -> Connection string (URI).
DB_URL=jdbc:postgresql://localhost:5432/hutka
DB_USER=hutka
DB_PASSWORD=hutka
DB_NAME=hutka

# === Redis (раздел 17.1) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === JWT (раздел 17.1) ===
# Сгенерируйте случайную строку не короче 32 символов, например: openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-random-secret-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

# === Почта (раздел 3.1, 3.3, 6.6, 17.3a) ===
# Провайдер на выбор (Resend/Postmark/SES/SMTP) — здесь пример под SMTP.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# === Внешние API (раздел 17.3) ===
DEEPSEEK_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# === Supabase Storage (раздел 17.3a) — понадобится позже, для фото ===
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_KEY=
